# ==============================================================================
# Ansible & Security Exclusions
# ==============================================================================
# Never commit your vault password files or plaintext strings
*.pass
vault.pass

# Exclude local ad-hoc inventory files or temporary connection mappings
hosts
inventory.ini

# ==============================================================================
# SSH Keys & Passwordless Authentication Files
# ==============================================================================
# Keep your generated AWS or server private keys local at all costs
*.pem
*.pub
id_rsa*
id_ed25519*
aws_credentials
authorized_keys

# ==============================================================================
# Python & Environment Exclusions
# ==============================================================================
# Virtual environments used for running Ansible/Boto3 locally
.venv/
venv/
env/
ENV/
bin/
lib/
include/
